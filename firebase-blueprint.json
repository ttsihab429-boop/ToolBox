{
  "entities": {
    "users": {
      "path": "users/{userId}",
      "description": "User profile and root collection for multi-tenant data isolation",
      "fields": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "updatedAt": { "type": "timestamp" }
      }
    },
    "businesses": {
      "path": "users/{userId}/businesses/{businessId}",
      "description": "Business profile for user's store or enterprise",
      "fields": {
        "id": { "type": "number" },
        "cloudId": { "type": "string" },
        "name": { "type": "string" },
        "businessType": { "type": "string" },
        "currency": { "type": "string" },
        "phone": { "type": "string" },
        "isDefault": { "type": "boolean" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "transactions": {
      "path": "users/{userId}/businesses/{businessId}/transactions/{transactionId}",
      "description": "Ledger transactions (sales, purchases, expenses, customer payments, supplier payments)",
      "fields": {
        "id": { "type": "number" },
        "cloudId": { "type": "string" },
        "businessId": { "type": "number" },
        "type": { "type": "string" },
        "title": { "type": "string" },
        "amount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "partyName": { "type": "string" },
        "partyPhone": { "type": "string" },
        "note": { "type": "string" },
        "timestamp": { "type": "number" },
        "dateString": { "type": "string" },
        "customerId": { "type": "number", "nullable": true },
        "supplierId": { "type": "number", "nullable": true },
        "productId": { "type": "number", "nullable": true },
        "quantity": { "type": "number" },
        "unitPrice": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "customers": {
      "path": "users/{userId}/businesses/{businessId}/customers/{customerId}",
      "description": "Customer accounts, opening dues, contact info",
      "fields": {
        "id": { "type": "number" },
        "cloudId": { "type": "string" },
        "businessId": { "type": "number" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "openingBalance": { "type": "number" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "suppliers": {
      "path": "users/{userId}/businesses/{businessId}/suppliers/{supplierId}",
      "description": "Supplier accounts, opening payables, contact info",
      "fields": {
        "id": { "type": "number" },
        "cloudId": { "type": "string" },
        "businessId": { "type": "number" },
        "name": { "type": "string" },
        "companyName": { "type": "string" },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "openingBalance": { "type": "number" },
        "note": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    },
    "products": {
      "path": "users/{userId}/businesses/{businessId}/products/{productId}",
      "description": "Inventory product catalog and real-time stock levels",
      "fields": {
        "id": { "type": "number" },
        "cloudId": { "type": "string" },
        "businessId": { "type": "number" },
        "name": { "type": "string" },
        "sku": { "type": "string" },
        "category": { "type": "string" },
        "purchasePrice": { "type": "number" },
        "sellingPrice": { "type": "number" },
        "currentQuantity": { "type": "number" },
        "unit": { "type": "string" },
        "lowStockThreshold": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      }
    }
  }
}
